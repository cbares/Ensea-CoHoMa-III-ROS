<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


 <xacro:macro name="modelidar_ros2_control" params="name prefix use_mock_hardware device">

<ros2_control name="${name}" type="system">
      <xacro:unless value="${use_mock_hardware}">
        <hardware>
          <plugin>modelidar/ModelidarSystemHardware</plugin>
          <param name="left_wheel_joint">${prefix}virtual_left_wheel_joint</param> <!-- this value is also in controllers yaml file -->
          <param name="right_wheel_joint">${prefix}virtual_right_wheel_joint</param> <!-- this value is also in controllers yaml file -->
          <param name="device">${device}</param> <!-- /dev/modelidar: udev/99-modelidar.rules -->
          <param name="baud_rate">115200</param>
          <param name="timeout">20</param> <!-- ms, per answer of the board (an answer takes ~5 ms; one cycle is 33 ms at 30 Hz) -->
          <param name="enc_counts_per_rev">544</param> <!-- 16x34 for encoder DAGU RS003-Enco -->
          <!-- Velocity loop gains, sent to the board at activation (all four, or none to keep
               the firmware defaults). See firmware/README.md, "Régulation de vitesse".
          <param name="kp">0.05</param>
          <param name="ki">0.5</param>
          <param name="kff">0.05</param>
          <param name="dmin">0.2</param>
          -->
        </hardware>
      </xacro:unless>
      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>
      </xacro:if>
      <joint name="${prefix}virtual_left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}virtual_right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>


  </xacro:macro>
</robot>