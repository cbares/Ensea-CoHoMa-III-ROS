{
    "name": "ROS 2 Development Container",
    "remoteUser": "theseus",
    "dockerComposeFile": "../docker/compose.yaml",
    "service": "modelibot_container",
    "runServices": [
        "modelibot_container",
        "lslidar_container"
    ],
    "workspaceFolder": "/home/theseus/ws",
    "customizations": {
        "vscode": {
            "extensions":[
                "ms-vscode.cpptools-extension-pack",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "anthropic.claude-code"
                ],
            "settings": {
                "C_Cpp.default.includePath": [
                    "/opt/ros/jazzy/include/**",
                    "/home/theseus/ws/install/modelidar/include/modelidar/**",
                    "/home/theseus/ws/src/Lslidar_ROS2_driver/lslidar_driver/include/**",
                    "/home/theseus/ws/install/lslidar_msgs/include/lslidar_msgs/**",
                    "/usr/include/**"
                ]
            }
        }
    }
}